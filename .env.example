APP_NAME="facturac.ao"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Luanda
APP_LOCALE=pt_AO
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# A work session is a fixed block that starts at sign-in and is tracked by the
# server, so refreshing the page does not extend it. Each user picks their own
# length on the security page; these bound that choice.
WORK_SESSION_ENABLED=true
WORK_SESSION_DEFAULT_MINUTES=25
WORK_SESSION_MIN_MINUTES=5
WORK_SESSION_MAX_MINUTES=480
WORK_SESSION_WARNING_SECONDS=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

AGT_CONNECT_TIMEOUT=3
AGT_REQUEST_TIMEOUT=10
AGT_POLL_INTERVAL=30
AGT_RATE_LIMIT_PER_MINUTE=30

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_RETENTION_DAYS=3650

# Pay4All e+ subscription collections use Referencia EMIS. Keep simulation enabled
# until Pay4All supplies the signed merchant API and webhook specification.
PAY4ALL_ENVIRONMENT=simulation
PAY4ALL_PRODUCTION_ENABLED=false
PAY4ALL_MERCHANT_ID=
PAY4ALL_API_KEY=
PAY4ALL_WEBHOOK_SECRET=
PAY4ALL_SIMULATION_ENTITY=00000
PAY4ALL_REFERENCE_LIFETIME_HOURS=24
PAY4ALL_TRANSACTION_FEE_BASIS_POINTS=100
PAY4ALL_MAXIMUM_REFERENCE_AMOUNT_MINOR=3000000000

AGT_DEFAULT_ENVIRONMENT=homologation
AGT_SCHEMA_VERSION=2.0
# Optional local AGT simulation identity. This default is the public HML-T01
# identity from AGT's controlled workbook; HML-T02 through HML-T05 are in config/agt.php.
AGT_HOMOLOGATION_FIXTURE_ALIAS=HML-T01
AGT_HOMOLOGATION_FIXTURE_NIF=5000413178
AGT_HOMOLOGATION_FIXTURE_EMAIL=agt.hml-t01@facturac.test
AGT_HOMOLOGATION_FIXTURE_PASSWORD=
AGT_HOMOLOGATION_BASE_URL=https://sifphml.minfin.gov.ao/sigt/fe/v1
AGT_PRODUCTION_ENABLED=false
AGT_PRODUCTION_BASE_URL=https://sifp.minfin.gov.ao/sigt/fe/v1
AGT_SOFTWARE_PRODUCT_NAME="facturac.ao"
AGT_SOFTWARE_COMPANY_NAME="VAP SOLUÇÕES, LDA"
AGT_SOFTWARE_COMPANY_TAX_ID=
# Signing-key version registered with AGT, not the software release version.
AGT_SOFTWARE_SIGNATURE_VERSION=1
AGT_QR_VERIFICATION_URL=https://quiosqueagt.minfin.gov.ao/facturacao-eletronica/consultar-fe
AGT_CONNECT_TIMEOUT=3
AGT_REQUEST_TIMEOUT=10
# Store PEM files outside the public web root; only references are saved in the database.
# AGT_SIGNING_KEY_DIRECTORY=/secure/path/to/agt-keys

BILLING_GATEWAY=wipay
WIPAY_ENVIRONMENT=sandbox
WIPAY_PRODUCTION_ENABLED=false
WIPAY_CLIENT_ID=
WIPAY_CLIENT_SECRET=
# Public HTTPS endpoint required for callbacks; leave unset to use APP_URL.
# WIPAY_CALLBACK_URL=https://facturac.ao/webhooks/wipay

# Support staff can enter a customer's account to reproduce a reported problem.
# Every session is recorded with a reason and capped in length. Grant access
# with "php artisan support:staff <email>".
IMPERSONATION_ENABLED=true
IMPERSONATION_MAX_MINUTES=30
IMPERSONATION_REASON_MIN_LENGTH=10

# Contact details shown on the Help page and in the legal documents. These are
# defaults only: support staff can override any of them from the console at
# /support/definicoes without a deploy.
PLATFORM_SUPPORT_EMAIL=apoio@vapsolucoes.ao
PLATFORM_SUPPORT_PHONE="+244 923 000 000"
PLATFORM_SUPPORT_WHATSAPP="+244 923 000 000"
PLATFORM_COMPLAINTS_EMAIL=reclamacoes@vapsolucoes.ao
PLATFORM_DPO_EMAIL=privacidade@vapsolucoes.ao

# External writes require both integration switches; disabled by default.
EXTERNAL_COMMAND_INTEGRATIONS_ENABLED=false

# Read-only assistant. Everything stays off until these are set; `php artisan assistant:check` says what is missing.
# The provider key is never placed here: ASSISTANT_PROVIDER_SECRET_FILE is the absolute path of a chmod 600 file holding only the key.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER_ENABLED=false
ASSISTANT_PROVIDER_EGRESS_ENABLED=false
# ASSISTANT_PROVIDER_SECRET_FILE=
# ASSISTANT_PROVIDER_DNS_PHP_CLI=
# ASSISTANT_PROVIDER_BUDGET_ID=
# ASSISTANT_PROVIDER_USAGE_BUDGET_ID=
# TENANT_AI_DEPLOYMENT_ID=
# ASSISTANT_PROVIDER_APPROVAL_REFERENCE=
# ASSISTANT_PROVIDER_NOTICE_URL=/privacidade
# ASSISTANT_PROVIDER_NOTICE_VERSION=p7-question-v1
# Reservation limits in micro-USD; each question reserves 552816. These are the highest values allowed:
# 60 questions a user a day, 300 and 5000 a company a day and a month, 3000 and 50000 overall.
# ASSISTANT_PROVIDER_BUDGET_ATTEMPT=600000
# ASSISTANT_PROVIDER_BUDGET_USER_DAY=33168960
# ASSISTANT_PROVIDER_BUDGET_WORKSPACE_DAY=165844800
# ASSISTANT_PROVIDER_BUDGET_WORKSPACE_MONTH=2764080000
# ASSISTANT_PROVIDER_BUDGET_DEPLOYMENT_DAY=1658448000
# ASSISTANT_PROVIDER_BUDGET_DEPLOYMENT_MONTH=27640800000
