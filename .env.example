APP_NAME="VAP Fatura"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Luanda
APP_LOCALE=pt_AO
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

AGT_CONNECT_TIMEOUT=3
AGT_REQUEST_TIMEOUT=10
AGT_POLL_INTERVAL=30
AGT_RATE_LIMIT_PER_MINUTE=30

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_RETENTION_DAYS=3650

# Pay4All e+ subscription collections use Referencia EMIS. Keep simulation enabled
# until Pay4All supplies the signed merchant API and webhook specification.
PAY4ALL_ENVIRONMENT=simulation
PAY4ALL_PRODUCTION_ENABLED=false
PAY4ALL_MERCHANT_ID=
PAY4ALL_API_KEY=
PAY4ALL_WEBHOOK_SECRET=
PAY4ALL_SIMULATION_ENTITY=00000
PAY4ALL_REFERENCE_LIFETIME_HOURS=24
PAY4ALL_TRANSACTION_FEE_BASIS_POINTS=100
PAY4ALL_MAXIMUM_REFERENCE_AMOUNT_MINOR=3000000000

AGT_DEFAULT_ENVIRONMENT=homologation
AGT_SCHEMA_VERSION=1.2
AGT_HOMOLOGATION_BASE_URL=https://sifphml.minfin.gov.ao/sigt/fe/v1
AGT_PRODUCTION_ENABLED=false
AGT_PRODUCTION_BASE_URL=https://sifp.minfin.gov.ao/sigt/fe/v1
AGT_CONNECT_TIMEOUT=3
AGT_REQUEST_TIMEOUT=10
# Store PEM files outside the public web root; only references are saved in the database.
# AGT_SIGNING_KEY_DIRECTORY=/secure/path/to/agt-keys
