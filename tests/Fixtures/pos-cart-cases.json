{
    "description": "Carts for the point of sale with the totals the server's FiscalCalculator produces for a Factura/Recibo. Prices and totals are integer minor units (cêntimos). Rules: the line net is the price times the quantity times one minus the discount, rounded down; tax on the line is the net times the rate, rounded up; the line gross is net plus tax; document totals are the sums of the lines. The server test and the Vue cart tests read this same file.",
    "cases": [
        {
            "name": "one article at normal VAT",
            "lines": [
                {
                    "unit_price_minor": 10000,
                    "quantity": "1",
                    "discount_percentage": "0",
                    "tax": {
                        "type": "IVA",
                        "code": "NOR",
                        "percentage": "14.00",
                        "exemption_code": null
                    }
                }
            ],
            "expected": {
                "settlement_total_minor": 0,
                "net_total_minor": 10000,
                "tax_payable_minor": 1400,
                "gross_total_minor": 11400,
                "lines": [
                    {
                        "net_minor": 10000,
                        "tax_minor": 1400,
                        "gross_minor": 11400
                    }
                ]
            }
        },
        {
