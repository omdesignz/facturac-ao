                                        "reconciliation_required": false
                                    },
                                    "meta": {
                                        "request_id": "11111111-1111-4111-8111-111111111111",
                                        "workspace_public_id": "01arz3ndektsv4rrffq69g5fav",
                                        "legal_entity_public_id": "01arz3ndektsv4rrffq69g5faw",
                                        "environment": "homologation"
